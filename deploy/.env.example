# Copy to .env next to compose.yaml. Never commit .env.
# Host loopback port for the gateway API + admin dashboard. VERIFY FREE with `ss -tulpn` first.
# Do NOT use 3000, 18080, 18081, 19119.
WA_GATEWAY_PORT=18091

# First-boot ADMIN key seed (>= 32 random chars). Leave empty to let OpenWA generate one into
# the data volume (/app/data/.api-key). Generate e.g. with: openssl rand -hex 32
API_MASTER_KEY=
# HMAC pepper for API-key hashing. Set BEFORE first boot and never change afterwards.
API_KEY_PEPPER=

# Empty = choose in dashboard (default whatsapp-web.js / Chromium). "baileys" uses far less RAM.
ENGINE_TYPE=baileys

MESSAGE_RETENTION_DAYS=1
TZ=Asia/Jakarta
OPENWA_MEM_LIMIT=1536m
