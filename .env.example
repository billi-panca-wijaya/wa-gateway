# ==============================================================================
# WHATSAPP OTP & GATEWAY ADD-ON CONFIGURATION (.env.example)
# ==============================================================================
# Salin file ini menjadi .env pada project Laravel Anda, atau tambahkan variabel
# di bawah ini ke dalam file .env yang sudah ada.
#
# Catatan Keamanan:
# JANGAN PERNAH meng-commit file .env yang berisi kunci rahasia asli ke Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kriptografi & Keamanan OTP (Wajib diisi di Production)
# ------------------------------------------------------------------------------
# Kunci rahasia minimal 32 karakter acak untuk HMAC verifier OTP (tidak disimpan di DB).
# Generate di Linux/Mac: openssl rand -hex 32
WA_OTP_HMAC_SECRET=generate-a-random-32-character-secret-key-here

# Mode Transport pengiriman pesan:
# - 'openwa' (Production / Staging: pengiriman nyata via OpenWA Gateway)
# - 'mock'   (Local / Testing: pesan tidak dikirim, hanya disimpan di memori/log)
WA_OTP_TRANSPORT=openwa

# ------------------------------------------------------------------------------
# 2. Cloudflare Turnstile Bot Protection (Wajib diisi di Production)
# ------------------------------------------------------------------------------
# Mencegah bot spamming Request OTP. Ambil kunci dari Cloudflare Dashboard -> Turnstile.
WA_OTP_TURNSTILE_ENABLED=true
WA_OTP_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here
WA_OTP_TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key-here

# Daftar domain frontend yang diizinkan (dipisahkan koma, tanpa http/https/port).
# PENTING: Jangan masukkan localhost / 127.0.0.1 di production!
WA_OTP_TURNSTILE_HOSTNAMES=your-domain.com,login.your-domain.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 3. Asynchronous Redis Queue & Worker (Wajib diisi di Production)
# ------------------------------------------------------------------------------
# Di production, OTP dikirim melalui queue Redis agar proses responsif & stabil.
WA_OTP_QUEUE_ENABLED=true
WA_OTP_QUEUE_CONNECTION=redis
WA_OTP_QUEUE_NAME=whatsapp-otp
WA_OTP_QUEUE_MAX_WAIT_SECONDS=30
WA_OTP_QUEUE_MAX_PENDING=1000

# Konfigurasi antrean Redis bawaan Laravel
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90

# ------------------------------------------------------------------------------
# 4. Koneksi ke OpenWA WhatsApp Gateway Engine
# ------------------------------------------------------------------------------
# URL tempat service OpenWA Docker berjalan (default host: 127.0.0.1:18091 atau http://openwa:2785 di Docker network).
OPENWA_BASE_URL=http://127.0.0.1:18091

# Session ID pengirim default yang telah di-pairing QR / code di OpenWA.
OPENWA_SESSION_ID=default-sender-session

# Operator API Key (opsional jika OpenWA dikunci token).
OPENWA_API_KEY=

# Dashboard Admin API Key untuk akses Backoffice Gateway embed.
# Dibuat di OpenWA dashboard dengan nama "website-dashboard" (role admin).
OPENWA_DASHBOARD_API_KEY=

# Timeout koneksi (detik)
OPENWA_CONNECT_TIMEOUT=3.0
OPENWA_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# 5. Multi-Sender Pool & Automatic Failover
# ------------------------------------------------------------------------------
# Mengelola banyak nomor WhatsApp pengirim sekaligus dengan rotasi otomatis.
WA_OTP_POOL_ENABLED=true
WA_OTP_POOL_FAILOVER_RETRIES=3
WA_OTP_POOL_AUTO_SUSPEND=true
WA_OTP_POOL_SUSPEND_COOLDOWN_MINUTES=30

# Pembatasan interval antar pesan per nomor pengirim untuk proteksi akun WA
WA_OTP_SENDER_LIMITS_ENABLED=true
WA_OTP_SENDER_MIN_INTERVAL_SECONDS=3

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Proteksi Kuota (Proteksi Abuse/Spam)
# ------------------------------------------------------------------------------
# Batas kirim per nomor HP (default: 5 permintaan per 900 detik / 15 menit)
WA_OTP_SEND_PER_PHONE=5
# Batas kirim per IP address
WA_OTP_SEND_PER_IP=20
# Batas kirim total dalam 1 tenant
WA_OTP_SEND_GLOBAL=500
# Batas kirim total sistem secara global
WA_OTP_SEND_SYSTEM=2000
# Jendela waktu batas kirim dalam detik (900 detik = 15 menit)
WA_OTP_SEND_WINDOW_SECONDS=900

# Batas percobaan verifikasi kode OTP salah per IP address
WA_OTP_VERIFY_PER_IP=60
WA_OTP_VERIFY_WINDOW_SECONDS=900
# Maksimal percobaan salah per challenge sebelum hangus
WA_OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 7. Format Pesan, Region & Tenant
# ------------------------------------------------------------------------------
# Region default jika nomor HP diketik tanpa awalan '+' (cth: '0812' -> ID / Indonesia +62)
WA_OTP_DEFAULT_REGION=ID

# Template pesan OTP yang dikirim ke WhatsApp member (:app, :code, :minutes)
WA_OTP_MESSAGE_TEMPLATE="Kode verifikasi masuk :app Anda adalah :code. Berlaku selama :minutes menit. Jangan berikan kode ini kepada siapapun."

# Tenant & Hostname mapping (untuk multi-tenant)
WA_OTP_DEFAULT_TENANT=default
WA_OTP_TENANT_HOSTS=

# Retensi data challenge yang sudah selesai (hari)
WA_OTP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 8. Webhook Integrasi Backoffice / Member Verified (Opsional)
# ------------------------------------------------------------------------------
# URL Webhook saat member berhasil diverifikasi untuk sync ke sistem backend lain.
WA_OTP_VERIFIED_MEMBER_WEBHOOK_URL=
WA_OTP_WEBHOOK_SECRET=
