# ==============================================================================
# WHATSAPP OTP & GATEWAY ADD-ON CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env in your Laravel project, or merge these variables
# into your existing .env file.
#
# Security Notice:
# NEVER commit your actual .env file containing live secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OTP Cryptography & Security (Required in Production)
# ------------------------------------------------------------------------------
# Random secret string (at least 32 characters) for HMAC OTP verification.
# Kept outside the database. Generate with: openssl rand -hex 32
WA_OTP_HMAC_SECRET=generate-a-random-32-character-secret-key-here

# Message delivery transport mode:
# - 'openwa' : Live delivery via self-hosted OpenWA Gateway (Production / Staging)
# - 'mock'   : In-memory simulation, no actual messages sent (Local / Testing)
WA_OTP_TRANSPORT=openwa

# ------------------------------------------------------------------------------
# 2. Cloudflare Turnstile Bot Protection (Required in Production)
# ------------------------------------------------------------------------------
# Protects against automated bot attacks on OTP requests.
# Obtain keys from: Cloudflare Dashboard -> Turnstile -> Add site (Widget Mode: Managed)
WA_OTP_TURNSTILE_ENABLED=true
WA_OTP_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here
WA_OTP_TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key-here

# Comma-separated list of allowed frontend hostnames (no http/https or port).
# Note: Do NOT include localhost or 127.0.0.1 in production environments!
WA_OTP_TURNSTILE_HOSTNAMES=your-domain.com,login.your-domain.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 3. Asynchronous Redis Queue & Supervised Worker (Required in Production)
# ------------------------------------------------------------------------------
# In production, OTP jobs are dispatched asynchronously to Redis to ensure high
# responsiveness, rate-pacing, and reliable delivery.
WA_OTP_QUEUE_ENABLED=true
WA_OTP_QUEUE_CONNECTION=redis
WA_OTP_QUEUE_NAME=whatsapp-otp
WA_OTP_QUEUE_MAX_WAIT_SECONDS=30
WA_OTP_QUEUE_MAX_PENDING=1000

# Laravel standard Cache & Queue configurations
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90

# ------------------------------------------------------------------------------
# 4. OpenWA WhatsApp Gateway Connection
# ------------------------------------------------------------------------------
# Base URL of the OpenWA container engine (e.g. host: 127.0.0.1:18091 or Docker network: http://openwa:2785)
OPENWA_BASE_URL=http://127.0.0.1:18091

# Default paired sender session ID registered in OpenWA
OPENWA_SESSION_ID=default-sender-session

# Operator API Key (optional token protection on OpenWA)
OPENWA_API_KEY=

# OpenWA Admin Dashboard API Key for embedded backoffice panel (role: admin)
OPENWA_DASHBOARD_API_KEY=

# HTTP connection timeouts in seconds
OPENWA_CONNECT_TIMEOUT=3.0
OPENWA_TIMEOUT=15.0

# ------------------------------------------------------------------------------
# 5. Multi-Sender Pool & Automatic Failover
# ------------------------------------------------------------------------------
# Distribute traffic across multiple WhatsApp sender numbers with automatic rotation.
WA_OTP_POOL_ENABLED=true
WA_OTP_POOL_FAILOVER_RETRIES=3
WA_OTP_POOL_AUTO_SUSPEND=true
WA_OTP_POOL_SUSPEND_COOLDOWN_MINUTES=30

# Minimum time interval between messages per sender number (prevents WhatsApp account bans)
WA_OTP_SENDER_LIMITS_ENABLED=true
WA_OTP_SENDER_MIN_INTERVAL_SECONDS=3

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Anti-Abuse Controls
# ------------------------------------------------------------------------------
# Maximum OTP request attempts per phone number (default: 5 per 15 minutes)
WA_OTP_SEND_PER_PHONE=5
# Maximum OTP request attempts per client IP
WA_OTP_SEND_PER_IP=20
# Maximum OTP requests per tenant
WA_OTP_SEND_GLOBAL=500
# Maximum total OTP requests system-wide
WA_OTP_SEND_SYSTEM=2000
# Rate limit tracking window in seconds (900 = 15 minutes)
WA_OTP_SEND_WINDOW_SECONDS=900

# Verification rate limits per client IP (prevents brute force guessing)
WA_OTP_VERIFY_PER_IP=60
WA_OTP_VERIFY_WINDOW_SECONDS=900
# Maximum failed OTP verification attempts per challenge before it is invalidated
WA_OTP_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 7. Localization, Region & Message Template
# ------------------------------------------------------------------------------
# Default ISO country code for phone numbers entered without international '+' prefix
WA_OTP_DEFAULT_REGION=ID

# Outbound OTP message template. Available placeholders: :app, :code, :minutes
WA_OTP_MESSAGE_TEMPLATE="Your :app sign-in code is :code. Expires in :minutes minutes. Do not share this code."

# Multi-tenant resolution: default tenant and hostname-to-tenant mapping ("host1=tenant1,host2=tenant2")
WA_OTP_DEFAULT_TENANT=default
WA_OTP_TENANT_HOSTS=

# Retention period in days for completed/expired challenge audit logs
WA_OTP_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 8. Backoffice & Webhook Integration (Optional)
# ------------------------------------------------------------------------------
# Webhook endpoint URL notified whenever a member successfully completes verification
WA_OTP_VERIFIED_MEMBER_WEBHOOK_URL=
WA_OTP_WEBHOOK_SECRET=
